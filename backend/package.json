{
  "name": "trustvault-backend",
  "version": "1.0.0",
  "description": "TrustVault - secure document sharing with an immutable audit trail",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "setup": "prisma generate && prisma db push && prisma db seed",
    "test": "jest --runInBand",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "prisma": "5.22.0",
    "supertest": "^7.0.0"
  }
}
